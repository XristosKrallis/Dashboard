@page
@model Dashboard.Web.Pages.Auth.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}
<div class="container-scroller">
    <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="content-wrapper d-flex align-items-center auth px-0">
            <div class="row w-100 mx-0">
                <div class="col-lg-4 mx-auto">
                    <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                        <div class="brand-logo">
                            <img src="~/images/logo.svg" alt="logo" />
                        </div>
                        <h4>Hello! let's get started</h4>
                        <h6 class="font-weight-light">Sign in to continue.</h6>

                        <form method="post" class="pt-3">
                            <div class="form-group">
                                <input type="email" asp-for="Email" class="form-control form-control-lg" placeholder="Email" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Email)</span>
                            </div>
                            <div class="form-group">
                                <input type="password" asp-for="Password" class="form-control form-control-lg" placeholder="Password" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Password)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="alert alert-danger">@Model.ErrorMessage</div>
                            }
                            <div class="mt-3 d-grid gap-2">
                                <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">
                                    SIGN IN
                                </button>
                            </div>
                            <div class="my-2 d-flex justify-content-between align-items-center">
                                <div class="form-check">
                                    <label class="form-check-label text-muted">
                                        <input type="checkbox" asp-for="RememberMe" class="form-check-input" /> Keep me signed in
                                    </label>
                                </div>
                                <div class="text-center mt-4 font-weight-light">
                                    Forgot password?
                                    <a asp-page="/Auth/ForgotPassword" class="text-primary">Create</a>
                                </div>
                            </div>
                            <div class="text-center mt-4 font-weight-light">
                                Don't have an account? 
                                <a asp-page="/Auth/Register" class="text-primary">Create</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- content-wrapper ends -->
    </div>
    <!-- page-body-wrapper ends -->
</div>

