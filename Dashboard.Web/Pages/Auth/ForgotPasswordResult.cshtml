@page
@model Dashboard.Web.Pages.Auth.ForgotPasswordResultModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password Reset Result";
}

<div class="container-scroller">
    <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="content-wrapper d-flex align-items-center auth px-0">
            <div class="row w-100 mx-0">
                <div class="col-lg-4 mx-auto">
                    <div class="auth-form-light text-center py-5 px-4 px-sm-5">
                        <div class="brand-logo">
                            <img src="~/images/logo.svg" alt="logo" />
                        </div>

                        @if (Model.IsSuccess)
                        {
                            <h4>Reset link sent!</h4>
                            <h6 class="font-weight-light">If an account exists for this email, a password reset link has been sent.</h6>
                        }
                        else
                        {
                            <h4>Email not found</h4>
                            <h6 class="font-weight-light">No account is associated with the provided email.</h6>
                        }

                        <div class="mt-4">
                            <a asp-page="/Auth/Login" class="btn btn-primary btn-lg">Back to Login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- content-wrapper ends -->
    </div>
    <!-- page-body-wrapper ends -->
</div>
