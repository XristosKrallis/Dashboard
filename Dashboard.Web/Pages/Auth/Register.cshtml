@page
@model Dashboard.Web.Pages.Auth.RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth px-0">
                <div class="row w-100 mx-0">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                            <div class="brand-logo">
                                <img src="~/images/logo.svg" alt="logo" />
                            </div>
                            <h4>New here?</h4>
                            <h6 class="font-weight-light">Signing up is easy. It only takes a few steps</h6>
                            <form class="pt-3" method="post">
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="alert alert-danger">@Model.ErrorMessage</div>
                            }
                            <div class="form-group">
                                <input asp-for="Username" class="form-control form-control-lg" placeholder="Username" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Username)</span>
                            </div>

                            <div class="form-group">
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="Email" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Email)</span>
                            </div>

                            <div class="form-group">
                                <select asp-for="Country" class="form-select form-select-lg">
                                    <option value="">Select Country</option>
                                    <option>United States of America</option>
                                    <option>United Kingdom</option>
                                    <option>India</option>
                                    <option>Germany</option>
                                    <option>Greece</option>
                                    <option>Argentina</option>
                                </select>
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Country)</span>
                            </div>

                            <div class="form-group">
                                <input asp-for="Password" class="form-control form-control-lg" placeholder="Password" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Password)</span>
                            </div>

                            <div class="form-group">
                                <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Confirm Password" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.ConfirmPassword)</span>
                            </div>

                            <div class="mb-4">
                                <div class="form-check">
                                    <label class="form-check-label text-muted">
                                        <input type="checkbox" class="form-check-input" /> I agree to all Terms & Conditions
                                    </label>
                                </div>
                            </div>

                            <div class="mt-3 d-grid gap-2">
                                <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">
                                    SIGN UP
                                </button>
                            </div>

                            <div class="text-center mt-4 font-weight-light">
                                Already have an account? <a asp-page="/Auth/Login" class="text-primary">Login</a>
                            </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <!-- content-wrapper ends -->
        </div>
        <!-- page-body-wrapper ends -->
    </div>