@page
@model Dashboard.Web.Pages.Auth.SettingsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Settings";
}

<div class="container-scroller">
    <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="content-wrapper d-flex align-items-center auth px-0">
            <div class="row w-100 mx-0">
                <div class="col-lg-6 mx-auto">
                    <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                        <div class="brand-logo text-center mb-4">
                            <h4>Account Settings</h4>
                        </div>

                        <form method="post" class="pt-3">

                            <h6 class="font-weight-medium">Profile Information</h6>
                            <div class="form-group">
                                <label asp-for="Username">Username</label>
                                <input type="text" asp-for="Username" class="form-control form-control-lg" placeholder="Username" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Username)</span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Email">Email</label>
                                <input type="email" asp-for="Email" class="form-control form-control-lg" placeholder="Email" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.Email)</span>
                            </div>

                            <h6 class="font-weight-medium mt-4">Change Password</h6>
                            <div class="form-group">
                                <label asp-for="NewPassword">New Password</label>
                                <input type="password" asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.NewPassword)</span>
                            </div>
                            <div class="form-group">
                                <label asp-for="ConfirmPassword">Confirm New Password</label>
                                <input type="password" asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Confirm Password" />
                                <span class="text-danger">@Html.ValidationMessageFor(m => m.ConfirmPassword)</span>
                            </div>

                            <div class="mt-3 d-grid gap-2">
                                <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium">
                                    Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- content-wrapper ends -->
    </div>
    <!-- page-body-wrapper ends -->
</div>
