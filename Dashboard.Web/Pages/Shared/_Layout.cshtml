@*
    Skydash Razor Pages Layout
    Assets are flattened into wwwroot/
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="~/vendors/css/vendor.bundle.base.css" />

    <!-- Plugin CSS -->
    <link rel="stylesheet" href="~/vendors/jvectormap/jquery-jvectormap.css" />
    <link rel="stylesheet" href="~/vendors/flag-icon-css/css/flag-icon.min.css" />
    <link rel="stylesheet" href="~/vendors/owl-carousel-2/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/vendors/owl-carousel-2/owl.theme.default.min.css" />

    <!-- Skydash Main CSS -->
    <link rel="stylesheet" href="~/css/style.css" />

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/images/favicon.png" />

    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.2.3/css/dx.light.css" />

    <!-- Vendor JS -->
    <script src="~/vendors/js/vendor.bundle.base.js"></script>

    <!-- Plugin JS -->
    <script src="~/vendors/chart.js/chart.umd.js"></script>
    <script src="~/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="~/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="~/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="~/vendors/owl-carousel-2/owl.carousel.min.js"></script>

    <!-- Skydash Core JS -->
    <script src="~/js/off-canvas.js"></script>
    <script src="~/js/hoverable-collapse.js"></script>
    <script src="~/js/misc.js"></script>
    <script src="~/js/settings.js"></script>
    <script src="~/js/todolist.js"></script>
    <script src="~/js/template.js"></script>

    <script src="https://cdn3.devexpress.com/jslib/23.2.3/js/dx.all.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.3/js/dx.aspnet.mvc.js"></script>
    <script src="https://cdn3.devexpress.com/jslib/23.2.7/js/dx.aspnet.data.js"></script>


    @RenderSection("Styles", required: false)
    
</head>
<body>
    <div class="container-scroller">

        <!-- TOP NAVBAR -->
        

        <nav class="navbar col-lg-12 col-12 p-0 d-flex flex-row fixed-top">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
                <a class="navbar-brand brand-logo" asp-page="/Index">
                    <img src="~/images/logo.svg" alt="logo" />
                </a>
                <a class="navbar-brand brand-logo-mini" asp-page="/Index">
                    <img src="~/images/logo-mini.svg" alt="logo" />
                </a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
                <ul class="navbar-nav navbar-nav-right">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item nav-profile dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" id="profileDropdown" aria-expanded="false">
                                <img src="../assets/images/faces/face28.jpg" alt="profile">
                            </a>
                            <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
                                <a class="dropdown-item" asp-page="/Auth/Settings">
                                    <i class="ti-settings text-primary"></i>
                                    Settings
                                </a>
                                <a class="dropdown-item" asp-page="/Auth/Logout">
                                    <i class="ti-power-off text-primary"></i>
                                    Logout
                                </a>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-primary" asp-page="/Auth/Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
        
        <div class="container-fluid page-body-wrapper">

            <!-- SIDEBAR -->
            <nav class="sidebar sidebar-offcanvas" id="sidebar">
                <ul class="nav">
                    <li class="nav-item nav-category">Main</li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            <span class="menu-title">Dashboard</span>
                            <i class="mdi mdi-view-dashboard menu-icon"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- MAIN PANEL -->
            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>

                <!-- FOOTER -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">
                            © @DateTime.Now.Year
                        </span>
                    </div>
                </footer>
            </div>
        </div>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
