
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0 fw-bold">Daily Work Hours</h5>
    </div>

    <div class="card-body p-3">
        @(Html.DevExtreme().DataGrid()
                .ID("workhours-grid")
                .DataSource(d => d.WebApi()
                    .Controller("WorkHoursProxy")
                    .LoadAction("LoadWorkHours")
                    .DeleteAction("DeleteWorkHours")
                    .Key("id")
                )
                .ShowBorders(true)
                .RowAlternationEnabled(true)
                .RemoteOperations(false)
                .Paging(p => p.PageSize(10)).Pager(pager => pager
                    .Visible(true)
                    .ShowPageSizeSelector(true)
                    .AllowedPageSizes(new int[] { 5, 10, 20 })

                    .ShowInfo(true)
                )
                .SearchPanel(s => s.Visible(true))
                .Columns(columns =>
                {
                    columns.Add()
                    .DataField("workDate")
                    .Caption("Date")
                    .DataType(GridColumnDataType.Date)
                    .Format("yyyy-MM-dd")
                    .SortOrder(SortOrder.Desc);

                    columns.Add()
                    .DataField("regularWork")
                    .Caption("Regular Work");

                    columns.Add()
                    .DataField("overtime")
                    .Caption("Overtime");

                    columns.Add()
                    .DataField("timeOff")
                    .Caption("Time Off");
                })
                .Editing(edit => edit
                    .Mode(GridEditMode.Popup)
                    .AllowAdding(true)
                    .AllowUpdating(true)
                    .AllowDeleting(true)
                    .ConfirmDelete(true)
                    .Popup(p => p
                    .MinWidth(300)
                    .MaxWidth(700)
                    .Height("auto")
                    .Title("Work Hours")
                    .ShowTitle(true)
                    )
                .Form(f => f.Items(items =>
                {
                    items.AddSimple()
                    .DataField("workDate")
                    .Editor(e => e.DateBox()
                    .Type(DateBoxType.Date)
                    .DisplayFormat("yyyy-MM-dd")
                    .DisabledDates(new JS("disableWorkDates"))
                    )
                    .ValidationRules(v =>
                    {
                        v.AddRequired().Message("Date is required.");
                    });

                    items.AddSimple()
                    .DataField("regularWork")
                    .Editor(e => e.NumberBox().Min(0))
                    .ValidationRules(v =>
                    {
                        v.AddRequired().Message("Regular Work is required.");
                    });

                    items.AddSimple()
                    .DataField("overtime")
                    .Editor(e => e.NumberBox().Min(0))
                    .ValidationRules(v =>
                    {
                        v.AddRequired().Message("Overtime is required.");
                    });

                    items.AddSimple()
                    .DataField("timeOff")
                    .Editor(e => e.NumberBox().Min(0))
                    .ValidationRules(v =>
                    {
                        v.AddRequired().Message("Time Off is required.");
                    });
                }))
                    )
                .OnSaving("onGridSaving")
                .OnSaved("onGridSaved")
                )
    </div>
</div>

<script>
        function onGridSaving(e) {

        if (!e.changes || e.changes.length === 0) return;

        var change = e.changes[0];

        if (change.type === "insert" || change.type === "update") {
            e.cancel = true;

            var grid = $("#workhours-grid").dxDataGrid("instance");
            var chart = $("#dailyWorkHoursChart").dxChart("instance");

            var data, method, action;

            if (change.type === "insert") {
                data = change.data;
                method = "POST";
                action = "/WorkHoursProxy/InsertWorkHours";
            } else if (change.type === "update") {
                var originalData = grid.getDataSource().items().find(x => x.id === change.key);
                data = Object.assign({}, originalData, change.data, { id: change.key });
                method = "PUT";
                action = "/WorkHoursProxy/UpdateWorkHours";
            }

            var regular = Number(data.regularWork);
            var overtime = Number(data.overtime);
            var timeOff = Number(data.timeOff);

            var total = regular + overtime + timeOff;

            if (total > 13) {
                DevExpress.ui.notify({
                    message: "Total hours (Regular + Overtime + Time Off) cannot exceed 13 hours.",
                    type: "error",
                    displayTime: 4000,
                    position: {
                        at: "top center",
                        my: "top center",
                        of: window
                    }
                });
                return;
            }

            $.ajax({
                url: action,
                type: method,
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function(response) {
                    grid.cancelEditData();
                    grid.refresh();
                    chart.refresh();
                },
                error: function(xhr) {
           
                    var message = "An error occurred.";
                    try {
                        var err = JSON.parse(xhr.responseText);
                        if (err.error) {
                            message = err.error;  
                        }
                    } catch {
                        message = xhr.responseText;
                    }

                    DevExpress.ui.notify({
                        message: message,
                        type: "error",
                        displayTime: 4000,
                        position: { at: "top center", my: "top center", of: window }
                    });

                }
            });
        }
    }
</script>

<script>
        function onGridSaved(e) {
        if (!e.changes || e.changes.length === 0) return;

        var grid = $("#workhours-grid").dxDataGrid("instance");
        var chart = $("#dailyWorkHoursChart").dxChart("instance");

        grid.refresh();      
        chart.refresh();     
    }
</script>

<script>
    function disableWorkDates(data) {
        const grid = $('#workhours-grid').dxDataGrid('instance');
        const items = grid.getDataSource().items();

        const cellDate = data.date;
        const cellKey = cellDate.toDateString();

        const isWeekend = cellDate.getDay() === 0 || cellDate.getDay() === 6;

        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const isFuture = cellDate > today;

        const isDuplicate = items.some(x =>
        x.workDate &&
        new Date(x.workDate).toDateString() === cellKey
        );

        return isWeekend || isFuture || isDuplicate;
    }
</script>