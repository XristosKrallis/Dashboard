<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0 fw-bold">Daily Work Hours</h5>
    </div>

    <div class="card-body p-3">
        @(Html.DevExtreme().DataGrid()
                .ID("workhours-grid")
                .DataSource(d => d.WebApi()
                .Controller("WorkHoursProxy")
                .LoadAction("LoadWorkHours")
                .InsertAction("InsertWorkHours")
                .UpdateAction("UpdateWorkHours")
                .DeleteAction("DeleteWorkHours")
                .Key("id")
                )
                .ShowBorders(true)
                .RowAlternationEnabled(true)
                .RemoteOperations(false)
                .Paging(p => p.PageSize(10)).Pager(pager => pager
                    .Visible(true)
                    .ShowPageSizeSelector(true)
                    .AllowedPageSizes(new int[] { 5, 10, 20 })
                    .ShowInfo(true)
                )
                .SearchPanel(s => s.Visible(true))
                .Columns(columns =>
                {
                    columns.Add()
                    .DataField("workDate")
                    .Caption("Date")
                    .DataType(GridColumnDataType.Date)
                    .Format("yyyy-MM-dd");

                    columns.Add()
                    .DataField("regularWork")
                    .Caption("Regular Work");

                    columns.Add()
                    .DataField("overtime")
                    .Caption("Overtime");

                    columns.Add()
                    .DataField("timeOff")
                    .Caption("Time Off");
                })
                .Editing(edit => edit
                .Mode(GridEditMode.Popup)
                .AllowAdding(true)
                .AllowUpdating(true)
                .AllowDeleting(true)
                .ConfirmDelete(true)
                .Popup(p => p
                .MinWidth(300)
                .MaxWidth(700)
                .Height("auto")
                .Title("Work Hours")
                .ShowTitle(true)
                )
                .Form(f => f.Items(items =>
                {
                    items.AddSimple()
                    .DataField("workDate")
                    .Editor(e => e.DateBox()
                    .Type(DateBoxType.Date)
                    .DisplayFormat("yyyy-MM-dd")
                    .DisabledDates(new JS(
                    @"function (data) {
                const grid = $('#workhours-grid').dxDataGrid('instance');
                const items = grid.getDataSource().items();

                // Apply rules only when ADDING a new row
                const isNewRow = !data.component.option('value');

                if (!isNewRow) {
                return false;
                }

                const cellDate = data.date;
                const cellKey = cellDate.toDateString();

                // Rule 1: weekends
                const isWeekend = cellDate.getDay() === 0 || cellDate.getDay() === 6;

                // Rule 2: future dates
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const isFuture = cellDate > today;

                // Rule 3: duplicate dates already in grid
                const isDuplicate = items.some(x =>
                x.workDate &&
                new Date(x.workDate).toDateString() === cellKey
                );

                return isWeekend || isFuture || isDuplicate;
                }"
                    ))
                    );

                    items.AddSimple().DataField("regularWork");
                    items.AddSimple().DataField("overtime");
                    items.AddSimple().DataField("timeOff");
                }))
                )
                )
    </div>
</div>
